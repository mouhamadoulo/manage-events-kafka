<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.formation.eda</groupId>
        <artifactId>manage-events-kafka</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>common-kafka</artifactId>
    <name>common-kafka</name>
    <description>Configuration Kafka partagee : serdes, error handlers, DLQ, idempotence</description>

    <!-- Module bibliotheque : pas de spring-boot-maven-plugin, donc pas de repackage. -->
    <dependencies>
        <dependency>
            <groupId>com.formation.eda</groupId>
            <artifactId>common-events</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>io.confluent</groupId>
            <artifactId>kafka-json-schema-serializer</artifactId>
        </dependency>

        <!--
          Les DEUX dependances suivantes sont <optional>true</optional>, et ce n'est pas un
          detail de style.

          WHY: les 6 services dependent de common-kafka, et 5 n'ont aucune base. En portee
          compile, spring-boot-starter-jdbc poserait Hikari et DataSourceAutoConfiguration sur
          leur classpath, et flyway-core y ajouterait FlywayAutoConfiguration, qui reclame une
          DataSource. Sans spring.datasource.url ni pilote, leur contexte echoue au demarrage
          sur « Failed to determine a suitable driver class » : les 5 tests de contexte
          passent au rouge, et ./mvnw clean verify ne passe plus.

          optional = la dependance est utilisable pour compiler ICI, mais n'est pas
          transitive. Chaque service qui a une base les redeclare explicitement (voir
          notification-service/pom.xml). La migration de db/migration/shared reste, elle, une
          ressource du jar : elle voyage sans la dependance.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
