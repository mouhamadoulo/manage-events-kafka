<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.formation.eda</groupId>
        <artifactId>manage-events-kafka</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>notification-service</artifactId>
    <name>notification-service</name>
    <description>Consumer terminal idempotent. Pur read-side.</description>

    <dependencies>
        <dependency>
            <groupId>com.formation.eda</groupId>
            <artifactId>common-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- @Valid sur le corps du rejeu : bornes de taille et motif du nom de topic. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
          Les deux modeles de programmation cohabitent volontairement dans ce module
          (P1-T7, ADR-002) : @KafkaListener par defaut, binding fonctionnel Spring Cloud
          Stream sous le profil "cloud-stream". Comparer sur le MEME cas est la seule facon
          de decider sur autre chose qu'une preference.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-stream-binder-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Persistance : redeclaree ICI parce qu'elle est <optional> dans common-kafka. Les 6
          services dependent de common-kafka et 5 n'ont pas de base ; en portee compile,
          FlywayAutoConfiguration y reclamerait une DataSource et leur contexte echouerait.
          notification-service est le premier service du projet a avoir une base : la table
          processed_event (P4-T1).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!--
          PIEGE Spring Boot 4 : « flyway-core » apporte la BIBLIOTHEQUE, pas
          l'auto-configuration. En Boot 4 les auto-configurations sont decoupees en modules
          (FlywayAutoConfiguration vit dans spring-boot-flyway), donc avec flyway-core seul le
          contexte demarre SANS RIEN DIRE et aucune migration n'est appliquee. Constate en
          P4-T6 : la table processed_event n'existait pas, et chaque evenement partait en DLT
          sur BadSqlGrammarException.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Flyway 10+ exige un module par base de donnees, en plus de flyway-core. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          Le seul test d'integration de la phase 4 : la table processed_event contre un vrai
          Postgres. L'INSERT ... ON CONFLICT DO NOTHING et le nombre de lignes affectees ne se
          verifient pas sans la base — c'est elle qui arbitre.
          La strategie de test complete (profil integration generalise) est la phase 10.
        -->
        <!--
          Testcontainers 2.0.5 : les artefacts ont ete RENOMMES par rapport a la 1.x.
          C'est « testcontainers-postgresql », pas « postgresql » — ce dernier n'existe plus et
          Maven echoue sur une version manquante, puisque le BOM ne le gere pas.
          La classe a aussi demenage : org.testcontainers.postgresql.PostgreSQLContainer,
          non generique, remplace org.testcontainers.containers.PostgreSQLContainer<SELF>.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
